<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_container_forgot_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_container"
    tools:context=".screens.forgot_password_screens.ForgotPassword">

    <ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFDDBB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFDDBB"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:visibility="visible"
            tools:context=".screens.forgot_password_screens.ForgotPassword">


            <ImageView
                android:layout_width="200dp"
                android:layout_height="252dp"
                android:src="@drawable/sad_human" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_rectangle"
                android:orientation="vertical"
                android:paddingHorizontal="37dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">


                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="47dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Forgot Password"
                    android:textAlignment="viewStart"
                    android:textColor="@color/on_background"
                    android:textSize="32sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto"
                    android:text="Please enter your mobile number associated with your account. You will receive an OTP to reset your password"
                    android:textColor="@color/on_background"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView5" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/forgotPass_phoneInput"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColorHint="@color/on_background"
                    app:boxStrokeColor="@color/secondary"
                    app:hintTextColor="@color/secondary"
                    app:prefixText="+92"
                    app:prefixTextColor="@color/tertiary"
                    app:startIconDrawable="@drawable/contacts"
                    app:startIconTint="@color/on_background">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:hint="Phone"
                        android:inputType="phone"
                        android:textColor="@color/on_background"
                        android:textColorHint="@color/on_background"
                        android:textCursorDrawable="@drawable/cursor" />
                </com.google.android.material.textfield.TextInputLayout>


                <Button
                    android:id="@+id/forgotPass_sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="60dp"
                    android:layout_marginBottom="156dp"
                    android:backgroundTint="@color/secondary"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Send"
                    android:textAlignment="center"
                    android:textColor="@color/on_secondary"
                    android:textColorLink="@color/secondary"
                    android:textSize="14sp"
                    android:typeface="normal"
                    app:cornerRadius="100dp" />


            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
