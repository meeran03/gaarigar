<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.order_screens.Rating">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/secondary_container"
            android:fontFamily="@font/product_sans_bold"
            android:gravity="center"
            android:text="Rate Service"
            android:textSize="40dp" />


        <RatingBar
            android:id="@+id/ratingIndicator"
            style="@style/Widget.AppCompat.RatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary_container"
            android:secondaryProgressTint="@color/secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ratingCommentInput"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"


            android:textColorHint="@color/on_background">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ratingCommentField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:hint="Comments"
                android:inputType="text"
                android:textColor="@color/on_background"
                android:textColorHint="@color/on_background"
                android:textCursorDrawable="@drawable/cursor" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/ratingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondary"
            android:text="RATE" />
    </LinearLayout>
</FrameLayout>
