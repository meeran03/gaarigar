<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_container_welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_container"
    tools:context=".screens.Welcome">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:maxHeight="900dp"
                android:theme="@style/Theme.Material3.DynamicColors.Light"
                app:layout_constrainedHeight="true">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signUp_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="52dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="52dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#00FFFFFF"
                    android:fontFamily="@font/roboto_medium"
                    android:inputType="text"
                    android:text="Sign Up"
                    android:textAlignment="center"
                    android:textColor="@color/secondary"
                    app:cornerRadius="100dp"
                    app:iconTintMode="add"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/login_button"
                    app:strokeColor="@color/secondary" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="323dp"
                    android:layout_height="83dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="60dp"
                    android:autoSizeMaxTextSize="60sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/samsungsharpsansbold"
                    android:text="GAARIGAR"
                    android:textAlignment="center"
                    android:textColor="#000"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/main_Slogon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="102dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="80dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@+id/textView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:srcCompat="@drawable/blacklogo" />

                <TextView
                    android:id="@+id/main_Slogon"
                    android:layout_width="297dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="57dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="57dp"
                    android:width="297sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:fontFamily="@font/roboto"
                    android:text="Get all your vehicles needs fixed at one stop"
                    android:textAlignment="center"
                    android:textColor="@color/on_background"
                    android:textColorLink="@color/on_background"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@+id/Working_Mechanic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView" />

                <ImageView
                    android:id="@+id/Working_Mechanic"
                    android:layout_width="282dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="65dp"
                    android:layout_marginTop="179dp"
                    android:layout_marginEnd="65dp"
                    app:layout_constraintBottom_toTopOf="@+id/login_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/main_Slogon"
                    app:srcCompat="@drawable/onboarding1" />

                <Button
                    android:id="@+id/login_button_go"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="52dp"
                    android:layout_marginTop="43dp"
                    android:layout_marginEnd="52dp"
                    android:backgroundTint="@color/secondary"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Login"
                    android:textAlignment="center"
                    android:textColor="@color/on_secondary"
                    android:textColorLink="@color/on_secondary"
                    android:textSize="14sp"
                    android:typeface="normal"
                    app:cornerRadius="100dp"
                    app:layout_constraintBottom_toTopOf="@+id/signUp_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/Working_Mechanic" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
