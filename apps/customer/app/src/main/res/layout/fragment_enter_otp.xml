<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_container_forgot_password_enter_otp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_container"
    tools:context=".screens.forgot_password_screens.EnterOTP">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFDDBB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFDDBB"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:visibility="visible"
            tools:context=".screens.forgot_password_screens.ForgotPassword">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="252dp"
                android:src="@drawable/human_with_round_mouth" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_rectangle"
                android:orientation="vertical"
                android:paddingHorizontal="37dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/enterOTP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="47dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Enter OTP"
                    android:textAlignment="viewStart"
                    android:textColor="@color/on_background"
                    android:textSize="32sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/enterOTPExplain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto"
                    android:text="Please enter the verification code sent on your mobile number associated with your account."
                    android:textColor="@color/on_background"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView5" />

                <com.chaos.view.PinView
                    android:id="@+id/pin_view"
                    style="@style/PinWidget.PinView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:cursorVisible="true"
                    android:inputType="number"
                    android:itemBackground="#65EAEAEA"
                    android:textColor="@color/on_background"
                    app:cursorColor="@color/secondary"
                    app:hideLineWhenFilled="true"
                    app:itemCount="6"
                    app:itemHeight="50dp"
                    app:itemRadius="8dp"
                    app:itemSpacing="22dp"
                    app:itemWidth="30dp"
                    app:lineColor="@color/on_background"
                    app:lineWidth="1dp" />


                <Button
                    android:id="@+id/verifyOTPButton"
                    android:layout_width="199dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp"
                    android:layout_marginBottom="175dp"
                    android:backgroundTint="@color/secondary"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Verify"
                    android:textAlignment="center"
                    android:textColor="@color/on_secondary"
                    android:textColorLink="@color/secondary"
                    android:textSize="14sp"
                    android:typeface="normal"
                    app:cornerRadius="100dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
