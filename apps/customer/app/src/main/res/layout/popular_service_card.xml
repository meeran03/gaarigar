<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serviceCardContainer"
    android:layout_width="match_parent"
    android:layout_height="207dp"
    android:layout_margin="10dp"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/serviceImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/sad_human" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="70dp">

            <TextView
                android:id="@+id/serviceName"
                android:layout_width="187dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="7dp"
                android:fontFamily="@font/product_sans_bold"
                android:maxLines="1"
                android:text="Car Wash kralo yarrof"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/on_background"
                android:textSize="18dp" />

            <RatingBar
                android:id="@+id/serviceRating"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/serviceName"
                android:layout_alignParentStart="true"
                android:layout_marginStart="7dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/secondary"
                android:progressBackgroundTint="@color/secondary"
                android:progressTint="@color/secondary"
                android:rating="3.5" />

            <TextView
                android:id="@+id/servicePrice"
                android:layout_width="98dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="38dp"
                android:layout_marginEnd="7dp"
                android:freezesText="true"
                android:inputType="number"
                android:maxLines="1"
                android:text="Rs. 300000"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/secondary"
                android:textSize="18dp" />
        </RelativeLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
